<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>AnchorFeeds-Setup</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <SuppressValidation>false</SuppressValidation>
    <SuppressIces>ICE38;ICE43;ICE64;ICE91</SuppressIces>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)..\AnchorFeeds\bin\Release\net10.0-windows10.0.19041.0\win-x64\publish</AppPublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);AppPublishDir=$(AppPublishDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
