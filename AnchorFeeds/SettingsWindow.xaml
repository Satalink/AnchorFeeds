<Window x:Class="AnchorFeeds.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AnchorFeeds.Models"
        xmlns:local="clr-namespace:AnchorFeeds"
    Title="AnchorFeeds Settings" Height="860" Width="900" MinHeight="650" MinWidth="720"
    WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Loaded="Window_Loaded"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource SurfaceBackgroundBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ElevatedBackgroundBrush}" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="(?)" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <EventSetter Event="Click" Handler="SettingHelpButton_Click" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="18,7" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Padding="18,7" Click="SaveButton_Click" />
        </StackPanel>
        <TabControl>
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8,8,4">
                        <TextBlock Text="Application Language / Locale" FontWeight="SemiBold" />
                        <ComboBox x:Name="ApplicationLanguageComboBox" Margin="0,4,0,8">
                            <ComboBoxItem Content="System default" Tag="system" />
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Čeština" Tag="cs" />
                            <ComboBoxItem Content="Deutsch" Tag="de" />
                            <ComboBoxItem Content="Español" Tag="es" />
                            <ComboBoxItem Content="Français" Tag="fr" />
                            <ComboBoxItem Content="Italiano" Tag="it" />
                            <ComboBoxItem Content="日本語" Tag="ja" />
                            <ComboBoxItem Content="한국어" Tag="ko" />
                            <ComboBoxItem Content="Polski" Tag="pl" />
                            <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR" />
                            <ComboBoxItem Content="Русский" Tag="ru" />
                            <ComboBoxItem Content="Türkçe" Tag="tr" />
                            <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                            <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                        </ComboBox>
                        <TextBlock Text="Application language changes take effect the next time you start the application."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Prompt instruction" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBox x:Name="AiPromptInstructionTextBox" Margin="0,4,0,4"
                                 MaxLength="500" />
                        <CheckBox x:Name="AiChatEnabledCheckBox" Content="Enable AI chat button"
                                  Margin="0,4,0,0" />
                        <TextBlock Text="The AI button opens the selected service only after you click it. The article body is copied to the clipboard; Gemini uses the clipboard for the full query because it has no prompt-prefill URL."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <CheckBox x:Name="PortableModeCheckBox" Content="Portable Mode (store settings in settings.yaml)"
                                  Margin="0,12,0,4"
                                  ToolTip="When selected, settings are stored beside the application in settings.yaml. When cleared, settings are stored under the current Windows user's registry." />
                        <TextBlock Text="Switching to registry storage deletes settings.yaml after saving settings to the registry. Switching back recreates settings.yaml from registry settings and removes the app's registry settings."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to tray"
                                  Margin="0,12,0,4"
                                  ToolTip="Hide the window in the notification area when you minimize it." />
                        <CheckBox x:Name="CloseToTrayCheckBox" Content="Close to tray"
                                  Margin="0,4"
                                  ToolTip="Keep AnchorFeeds running in the notification area when you close the window." />
                        <CheckBox x:Name="LaunchAtStartupCheckBox" Content="Launch at startup"
                                  Margin="0,4,0,0"
                                  ToolTip="Start AnchorFeeds when you sign in to Windows." />
                        <TextBlock Text="Launch at startup is independent of Minimize to tray. The app starts hidden only when both options are enabled."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                        <CheckBox x:Name="RetrieveLatestFeedsOnLaunchCheckBox"
                                  Content="Retrieve latest feeds on application launch"
                                  IsChecked="True" Margin="0,12,0,4" />
                        <TextBlock Text="Feed update polling interval" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <ComboBox x:Name="FeedUpdateIntervalComboBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Manual only" />
                            <ComboBoxItem Content="15 minutes" />
                            <ComboBoxItem Content="30 minutes" />
                            <ComboBoxItem Content="1 hour" />
                            <ComboBoxItem Content="2 hours" />
                            <ComboBoxItem Content="6 hours" />
                            <ComboBoxItem Content="12 hours" />
                            <ComboBoxItem Content="1 day" />
                        </ComboBox>
                        <TextBlock Text="Manual only disables scheduled updates for feeds that use the global interval. Per-feed interval overrides remain scheduled."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="Media output directory" FontWeight="SemiBold" />
                            <Button Style="{StaticResource HelpButtonStyle}"
                                    ToolTip="Select the folder where article folders and their audio and media will be stored. Temporary generation files are stored in a .tmp subfolder." />
                        </StackPanel>
                        <DockPanel Margin="0,4,0,4" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,4" Margin="8,0,0,0"
                                    Click="BrowseOutputDirectoryButton_Click" />
                            <TextBox x:Name="OutputDirectoryTextBox" IsReadOnly="True"
                                     PreviewMouseLeftButtonDown="OutputDirectoryTextBox_PreviewMouseLeftButtonDown"
                                     ToolTip="Click to select a media output directory"
                                     AutomationProperties.Name="Media output directory"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Interface">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8,8,8">
                        <TextBlock Text="Theme" FontWeight="SemiBold" />
                        <ComboBox x:Name="InterfaceThemeComboBox" Margin="0,4,0,8">
                            <ComboBoxItem Content="Light" Tag="light" />
                            <ComboBoxItem Content="Dark" Tag="dark" />
                            <ComboBoxItem Content="Charcoal" Tag="charcoal" />
                            <ComboBoxItem Content="System Desktop Theme" Tag="system_desktop" />
                        </ComboBox>
                        <TextBlock Text="System Desktop Theme follows the Windows light/dark app setting and uses Windows system colors for text, controls, and selection. The theme is applied when you save settings."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <TextBlock Text="Text appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Title List" FontWeight="SemiBold" />
                                <TextBlock Text="Font family" Margin="0,6,0,0" />
                                <ComboBox x:Name="ArticleListFontFamilyComboBox" IsEditable="True" Margin="0,2,0,0">
                                    <ComboBoxItem Content="Segoe UI" />
                                    <ComboBoxItem Content="Arial" />
                                    <ComboBoxItem Content="Calibri" />
                                    <ComboBoxItem Content="Consolas" />
                                    <ComboBoxItem Content="Georgia" />
                                    <ComboBoxItem Content="Tahoma" />
                                    <ComboBoxItem Content="Times New Roman" />
                                    <ComboBoxItem Content="Verdana" />
                                </ComboBox>
                                <TextBlock Text="Font size" Margin="0,6,0,0" />
                                <ComboBox x:Name="ArticleListFontSizeComboBox" IsEditable="True" Margin="0,2,0,0">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="11" />
                                    <ComboBoxItem Content="12" />
                                    <ComboBoxItem Content="13" />
                                    <ComboBoxItem Content="14" />
                                    <ComboBoxItem Content="16" />
                                    <ComboBoxItem Content="18" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="24" />
                                    <ComboBoxItem Content="28" />
                                    <ComboBoxItem Content="32" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Article Text" FontWeight="SemiBold" />
                                <TextBlock Text="Font family" Margin="0,6,0,0" />
                                <ComboBox x:Name="ArticleTextFontFamilyComboBox" IsEditable="True" Margin="0,2,0,0">
                                    <ComboBoxItem Content="Segoe UI" />
                                    <ComboBoxItem Content="Arial" />
                                    <ComboBoxItem Content="Calibri" />
                                    <ComboBoxItem Content="Consolas" />
                                    <ComboBoxItem Content="Georgia" />
                                    <ComboBoxItem Content="Tahoma" />
                                    <ComboBoxItem Content="Times New Roman" />
                                    <ComboBoxItem Content="Verdana" />
                                </ComboBox>
                                <TextBlock Text="Font size" Margin="0,6,0,0" />
                                <ComboBox x:Name="ArticleTextFontSizeComboBox" IsEditable="True" Margin="0,2,0,0">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="11" />
                                    <ComboBoxItem Content="12" />
                                    <ComboBoxItem Content="13" />
                                    <ComboBoxItem Content="14" />
                                    <ComboBoxItem Content="16" />
                                    <ComboBoxItem Content="18" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="24" />
                                    <ComboBoxItem Content="28" />
                                    <ComboBoxItem Content="32" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Hot keys" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Select a shortcut field and press the desired key or key combination. Use Ctrl, Shift, or Alt as modifiers. Press Backspace or Delete to disable a shortcut."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="12" Text="Next media / Seek forward 30s" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="ForwardHotkeyTextBox" Grid.Row="12" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="13" Text="Previous media / Seek back 10s" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="BackwardHotkeyTextBox" Grid.Row="13" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="0" Text="Play / Pause" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="PlayPauseHotkeyTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="1" Text="Next article" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="SkipNextHotkeyTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="2" Text="Previous article" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="PreviousBackHotkeyTextBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="3" Text="Player volume up" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="VolumeUpHotkeyTextBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="4" Text="Player volume down" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="VolumeDownHotkeyTextBox" Grid.Row="4" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="5" Text="Mute" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="MuteHotkeyTextBox" Grid.Row="5" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="6" Text="Full mode" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="FullModeHotkeyTextBox" Grid.Row="6" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="7" Text="Scan mode" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="ScanModeHotkeyTextBox" Grid.Row="7" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="8" Text="Refresh Library" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="RefreshLibraryHotkeyTextBox" Grid.Row="8" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="9" Text="Refresh Article" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="RefreshArticleHotkeyTextBox" Grid.Row="9" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="10" Text="Mark all as Read" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="MarkAllAsReadHotkeyTextBox" Grid.Row="10" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                            <TextBlock Grid.Row="11" Text="Settings" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox x:Name="SettingsHotkeyTextBox" Grid.Row="11" Grid.Column="1" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" Margin="4,2" />
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Ticker">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8,8,8">
                        <TextBlock Text="Desktop headline ticker" FontWeight="SemiBold" />
                        <TextBlock Text="Scrolls unread article titles along the desktop edge. Choose what clicking a ticker item does below."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <CheckBox x:Name="TickerWhenMinimizedCheckBox" Content="Show ticker when the application is minimized"
                                  Margin="0,4" />
                        <CheckBox x:Name="TickerWhenClosedToTrayCheckBox" Content="Show ticker when the application is closed to tray"
                                  Margin="0,4" />
                        <TextBlock Text="Closing to tray requires 'Close to tray' under General." 
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <CheckBox x:Name="TickerMarkReadCheckBox" Content="Mark an article as read when its title is read aloud"
                                  Margin="0,4" />
                        <TextBlock Text="Left click action" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <ComboBox x:Name="TickerClickActionComboBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Open article in app" Tag="open_article" />
                            <ComboBoxItem Content="Open article source in browser" Tag="open_source_in_browser" />
                            <ComboBoxItem Content="Play body audio in app" Tag="play_body_audio" />
                            <ComboBoxItem Content="Play body audio in ticker" Tag="play_body_audio_in_ticker" />
                            <ComboBoxItem Content="Mark as read" Tag="mark_as_read" />
                        </ComboBox>
                        <TextBlock Text="Right click action" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <ComboBox x:Name="TickerRightClickActionComboBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Open article in app" Tag="open_article" />
                            <ComboBoxItem Content="Open article source in browser" Tag="open_source_in_browser" />
                            <ComboBoxItem Content="Play body audio in app" Tag="play_body_audio" />
                            <ComboBoxItem Content="Play body audio in ticker" Tag="play_body_audio_in_ticker" />
                            <ComboBoxItem Content="Mark as read" Tag="mark_as_read" />
                        </ComboBox>
                        <TextBlock Text="Ticker playback pauses scrolling and temporarily unmutes the ticker if needed."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <ComboBox x:Name="TickerPositionComboBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Top of desktop" Tag="top" />
                            <ComboBoxItem Content="Bottom of desktop" Tag="bottom" />
                        </ComboBox>
                        <TextBlock Text="Font family" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <ComboBox x:Name="TickerFontFamilyComboBox" IsEditable="True" Margin="0,4,0,4">
                            <ComboBoxItem Content="Segoe UI" />
                            <ComboBoxItem Content="Arial" />
                            <ComboBoxItem Content="Calibri" />
                            <ComboBoxItem Content="Consolas" />
                            <ComboBoxItem Content="Georgia" />
                            <ComboBoxItem Content="Tahoma" />
                            <ComboBoxItem Content="Times New Roman" />
                            <ComboBoxItem Content="Verdana" />
                        </ComboBox>
                        <TextBlock Text="Font size" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ComboBox x:Name="TickerFontSizeComboBox" IsEditable="True" Margin="0,4,0,4">
                            <ComboBoxItem Content="10" />
                            <ComboBoxItem Content="12" />
                            <ComboBoxItem Content="14" />
                            <ComboBoxItem Content="16" />
                            <ComboBoxItem Content="18" />
                            <ComboBoxItem Content="20" />
                            <ComboBoxItem Content="24" />
                            <ComboBoxItem Content="28" />
                        </ComboBox>
                        <TextBlock Text="Ticker height" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ComboBox x:Name="TickerHeightComboBox" IsEditable="True" Margin="0,4,0,4">
                            <ComboBoxItem Content="48" />
                            <ComboBoxItem Content="56" />
                            <ComboBoxItem Content="64" />
                            <ComboBoxItem Content="80" />
                            <ComboBoxItem Content="96" />
                            <ComboBoxItem Content="120" />
                            <ComboBoxItem Content="160" />
                        </ComboBox>
                        <TextBlock Text="Height in pixels (48-200). Thumbnails scale with the height."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Scroll speed" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ComboBox x:Name="TickerScrollSpeedComboBox" Margin="0,4,0,4">
                            <ComboBoxItem Content="Very slow" Tag="25" />
                            <ComboBoxItem Content="Slow" Tag="40" />
                            <ComboBoxItem Content="Medium" Tag="60" />
                            <ComboBoxItem Content="Fast" Tag="100" />
                            <ComboBoxItem Content="Very fast" Tag="160" />
                        </ComboBox>
                        <TextBlock Text="Favorites notification" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <ComboBox x:Name="TickerNotificationComboBox" Margin="0,4,0,4"
                                  SelectionChanged="TickerNotificationComboBox_SelectionChanged">
                            <ComboBoxItem Content="None" Tag="none" />
                            <ComboBoxItem Content="Windows notification" Tag="windows" />
                            <ComboBoxItem Content="Sound" Tag="sound" />
                        </ComboBox>
                        <TextBlock Text="Shown when a new favorite article arrives while the ticker is active. Sound is not played while audio is muted."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="TickerSoundPanel" Margin="0,8,0,0">
                            <TextBlock Text="Notification sound" FontWeight="SemiBold" />
                            <DockPanel Margin="0,4,0,4" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,4" Margin="8,0,0,0"
                                        Click="BrowseTickerSoundButton_Click" />
                                <Button DockPanel.Dock="Right" Content="Default" Padding="10,4" Margin="8,0,0,0"
                                        Click="ClearTickerSoundButton_Click" />
                                <TextBox x:Name="TickerSoundPathTextBox" IsReadOnly="True"
                                         AutomationProperties.Name="Notification sound file"
                                         VerticalContentAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Select a .wav or .mp3 file, or use Default for the Windows notification sound."
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Feeds">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8,8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Configured RSS or Atom feeds" FontWeight="SemiBold" />
                            <Button Style="{StaticResource HelpButtonStyle}"
                                    ToolTip="Set a display name, RSS or Atom feed link, category, and update period for each feed. Use the gear button to manage favorite and blocked RSS categories. Blocked categories prevent new matching articles from being added." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Add Feed" Padding="10,4" Margin="0,0,8,0"
                                    Click="AddFeedButton_Click" />
                            <Button Content="Remove Selected" Padding="10,4"
                                    Click="RemoveFeedButton_Click" />
                        </StackPanel>
                        <DataGrid x:Name="FeedGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  MinHeight="260" MaxHeight="420" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="1.1*" />
                                <DataGridTextColumn Header="Feed Link" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2*" />
                                <DataGridComboBoxColumn Header="Group"
                                    ItemsSource="{x:Static models:FeedConfiguration.GroupOptions}"
                                    SelectedValueBinding="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Value" DisplayMemberPath="Label" Width="1.6*" />
                                <DataGridComboBoxColumn Header="Update Period"
                                    ItemsSource="{x:Static models:FeedConfiguration.UpdatePeriodOptions}"
                                    SelectedValueBinding="{Binding UpdatePeriod, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Value" DisplayMemberPath="Label" Width="1.5*" />
                                <DataGridCheckBoxColumn Header="Enabled" Width="68"
                                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Header="" Width="38">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="⚙" Tag="{Binding}" Padding="4,1"
                                                    ToolTip="Feed category properties"
                                                    Click="FeedPropertiesButton_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Scheduled updates honor each feed's period. Use global interval follows General settings; Manual only disables scheduled checks for that feed. Update Feeds checks every enabled feed; unchecked feeds are never fetched."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Banned words and phrases" FontWeight="SemiBold" />
                            <Button Style="{StaticResource HelpButtonStyle}"
                                    ToolTip="New feed items whose title or text contain any of these whole words or phrases are skipped. Type a word or phrase and press Enter or comma. Existing library items are not deleted." />
                        </StackPanel>
                        <local:PhrasePillEditor x:Name="BannedPhrasesEditor" Margin="0,4,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Favorited words and phrases" FontWeight="SemiBold" />
                            <Button Style="{StaticResource HelpButtonStyle}"
                                    ToolTip="Items whose title or text contain any of these whole words or phrases are treated like favorite categories (Favorites filter, blue ribbon, Full mode option)." />
                        </StackPanel>
                        <local:PhrasePillEditor x:Name="FavoritedPhrasesEditor" Margin="0,4,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Starred words and phrases" FontWeight="SemiBold" />
                            <Button Style="{StaticResource HelpButtonStyle}"
                                    ToolTip="New feed items whose title or text contain any of these whole words or phrases are starred automatically when they are added." />
                        </StackPanel>
                        <local:PhrasePillEditor x:Name="StarredPhrasesEditor" Margin="0,4,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scan mode countdown" FontWeight="SemiBold" />
                            <Button Style="{StaticResource HelpButtonStyle}"
                                    ToolTip="In Scan mode, the app plays the article title, shows this countdown, then advances to the next item. Full mode plays the article body after the title." />
                        </StackPanel>
                        <ComboBox x:Name="ScanCountdownComboBox" Margin="0,4,0,12">
                            <ComboBoxItem Content="0 seconds" Tag="0" />
                            <ComboBoxItem Content="3 seconds" Tag="3" />
                            <ComboBoxItem Content="5 seconds" Tag="5" />
                            <ComboBoxItem Content="7 seconds" Tag="7" />
                            <ComboBoxItem Content="10 seconds" Tag="10" />
                            <ComboBoxItem Content="15 seconds" Tag="15" />
                            <ComboBoxItem Content="20 seconds" Tag="20" />
                            <ComboBoxItem Content="30 seconds" Tag="30" />
                            <ComboBoxItem Content="60 seconds" Tag="60" />
                        </ComboBox>
                        <CheckBox x:Name="FullModeForFavoritesCheckBox"
                                  Content="Read favorite category articles in Full mode while Scan mode is on"
                                  ToolTip="When Scan mode is active, articles in a favorited category play their full body after the title instead of advancing after the countdown."
                                  Margin="0,0,0,12" />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>


                <TabItem Header="Audio">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="12,8,8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Audio retention" FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpButtonStyle}"
                                ToolTip="How long generated article MP3s are kept before the library removes them. Enter a positive number and hours, days, or weeks: 12 hours, 3 days, or 2 weeks. Expiration is checked when the library loads or refreshes." />
                    </StackPanel>
                    <TextBox x:Name="RetentionTextBox" Margin="0,4,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Speech engine" FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpButtonStyle}"
                                ToolTip="Edge TTS uses Microsoft's online voices and needs an internet connection. If Edge TTS fails for an article, the app automatically falls back to the offline Windows speech voice, encoded to MP3 with FFmpeg. Windows speech always uses the default Windows voice." />
                    </StackPanel>
                    <ComboBox x:Name="TtsEngineComboBox" Margin="0,4,0,12">
                        <ComboBoxItem Content="Edge TTS (online, no fall back)" Tag="edge_tts_only" />
                        <ComboBoxItem Content="Edge TTS (online, falls back to Windows speech)" Tag="edge_tts" />
                        <ComboBoxItem x:Name="WindowsTtsItem" Content="Windows speech (offline, uses FFmpeg)" Tag="windows" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MP3 bitrate" FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpButtonStyle}"
                                ToolTip="Default uses Edge TTS's native 24 kHz, 48 kbps mono MP3 without FFmpeg. 48 kbps also uses this native output. Choose 96-320 kbps to re-encode with FFmpeg; higher bitrates increase file size but cannot restore detail absent from the source. The page-turn cue plays in the app between articles and is not included in MP3 files." />
                    </StackPanel>
                    <ComboBox x:Name="Mp3BitrateComboBox" Margin="0,4,0,12">
                        <ComboBoxItem Content="Default" Tag="0" />
                        <ComboBoxItem Content="48 kbps (Edge TTS)" Tag="48" />
                        <ComboBoxItem Content="96 kbps" Tag="96" />
                        <ComboBoxItem Content="128 kbps" Tag="128" />
                        <ComboBoxItem Content="160 kbps" Tag="160" />
                        <ComboBoxItem Content="192 kbps" Tag="192" />
                        <ComboBoxItem Content="256 kbps" Tag="256" />
                        <ComboBoxItem Content="320 kbps" Tag="320" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox x:Name="AutoPlayNextCheckBox" Content="Auto Play Next" />
                        <Button Style="{StaticResource HelpButtonStyle}"
                                ToolTip="Automatically start the next article when the current article finishes. Playback stops at the end of the library." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox x:Name="ShowArticleTextCheckBox" Content="Show article text in player view" />
                        <Button Style="{StaticResource HelpButtonStyle}"
                                ToolTip="Shows or hides the text used to create the selected article's narration in the player view." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox x:Name="ShowUnplayedOnlyCheckBox" Content="Enable Unplayed only when the app starts" />
                        <Button Style="{StaticResource HelpButtonStyle}"
                                ToolTip="Starts the main window with its Unplayed only filter turned on. You can change the filter at any time." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mark article as played" FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpButtonStyle}"
                                ToolTip="Choose when an article changes to played: as soon as playback starts, or after playback ends or you skip to another article." />
                    </StackPanel>
                    <ComboBox x:Name="MarkAsPlayedComboBox" Margin="0,4,0,12">
                        <ComboBoxItem Content="When started" Tag="when_started" />
                        <ComboBoxItem Content="When ended or skipped" Tag="when_ended_or_skipped" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Anchor(s) (select multiple voices)" FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpButtonStyle}"
                                ToolTip="Check one or more voices. Newly generated articles rotate through the selected voices. Expand a language/country group to browse voices; use Sample to preview a voice. Voice synthesis requires an internet connection." />
                    </StackPanel>
                    <TreeView x:Name="VoicesTreeView" Height="280" Margin="0,4,0,4">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type models:VoiceLocaleGroup}"
                                                  ItemsSource="{Binding Voices}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding Locale}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type models:VoiceOption}">
                            <DataTemplate.Resources>
                                <Storyboard x:Key="SpinSampleIcon" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="LoadingIcon"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.8" />
                                </Storyboard>
                            </DataTemplate.Resources>
                            <DockPanel LastChildFill="True">
                                <Button Tag="{Binding}" DockPanel.Dock="Right" Padding="6,2" Margin="8,0,0,0"
                                        Click="VoiceSampleButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.35" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <StackPanel x:Name="SampleLabel" Orientation="Horizontal">
                                            <TextBlock Text="▶" Margin="0,0,4,0" />
                                            <TextBlock Text="Sample" />
                                        </StackPanel>
                                        <StackPanel x:Name="LoadingLabel" Orientation="Horizontal" Visibility="Collapsed">
                                            <TextBlock x:Name="LoadingIcon" Text="⟳" Margin="0,0,4,0"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="Loading..." />
                                        </StackPanel>
                                        <StackPanel x:Name="PlayingLabel" Orientation="Horizontal" Visibility="Collapsed">
                                            <TextBlock Text="▶" Margin="0,0,4,0" />
                                            <TextBlock Text="Playing" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter TargetName="SampleLabel" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="LoadingLabel" Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="BeginSampleIconSpin"
                                                         Storyboard="{StaticResource SpinSampleIcon}" />
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="BeginSampleIconSpin" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="SampleLabel" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="PlayingLabel" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </TreeView.Resources>
                    </TreeView>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="StopVoiceSampleButton" Content="Stop sample" DockPanel.Dock="Right"
                                Padding="8,3" IsEnabled="False" Click="StopVoiceSampleButton_Click" />
                        <TextBlock x:Name="VoiceCatalogStatus" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                    </DockPanel>
                    <MediaElement x:Name="VoiceSamplePlayer" Width="1" Height="1" Opacity="0"
                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  MediaOpened="VoiceSamplePlayer_MediaOpened"
                                  MediaEnded="VoiceSamplePlayer_MediaEnded"
                                  MediaFailed="VoiceSamplePlayer_MediaFailed" />
                  </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Maintenance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8,8,8">
                        <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
                        <CheckBox x:Name="DebugLoggingCheckBox" Content="Enable verbose debug logging"
                                  Margin="0,6,0,2"
                                  ToolTip="Write detailed application diagnostics to AnchorFeeds-debug.log beside the application." />
                        <TextBlock Text="When enabled, diagnostic details are appended to AnchorFeeds-debug.log in the application folder. The file may include article titles, media paths, feed URLs, and playback events."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="Rebuild Library" FontWeight="SemiBold" />
                        <TextBlock Text="Total reset: permanently deletes the library's article audio files and matching article folders, including cached images and text."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <Button x:Name="RebuildLibraryButton" Content="Rebuild Library..." HorizontalAlignment="Left"
                                Padding="14,6" Click="RebuildLibraryButton_Click" />
                        <TextBlock Text="Prune Feed Library" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="Deletes articles (audio, images, and text) older than the retention period set under Audio."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <Button x:Name="PruneLibraryButton" Content="Prune Feed Library..." HorizontalAlignment="Left"
                                Padding="14,6" Click="PruneLibraryButton_Click" />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
        </TabControl>
    </DockPanel>
</Window>
