<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AnchorFeeds</AssemblyName>
    <RootNamespace>AnchorFeeds</RootNamespace>
    <AssemblyTitle>AnchorFeeds</AssemblyTitle>
    <Product>AnchorFeeds</Product>
    <Company>AnchorFeeds</Company>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\settings.yaml" Link="settings.yaml"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\page-flip.wav" />
  </ItemGroup>

</Project>
