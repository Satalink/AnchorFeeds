<UserControl x:Class="AnchorFeeds.PhrasePillEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6,6,6,0"
            Background="{DynamicResource SurfaceBackgroundBrush}" MinHeight="64"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
            <WrapPanel>
                <ItemsControl x:Name="PillsItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="8,3" Margin="0,0,6,6">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="×" Tag="{Binding}"
                                            Padding="3,0" Margin="6,0,0,0" BorderThickness="0"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Click="RemoveButton_Click" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="InputBox" MinWidth="160" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Top" Margin="0,2,0,6"
                         KeyDown="InputBox_KeyDown" LostFocus="InputBox_LostFocus" />
            </WrapPanel>
        </ScrollViewer>
    </Border>
</UserControl>
