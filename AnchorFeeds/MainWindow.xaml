<Window x:Class="AnchorFeeds.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:AnchorFeeds.Services"
        Title="AnchorFeeds" Height="760" Width="1120" MinHeight="600" MinWidth="850"
        Icon="/Assets/AnchorFeeds.ico"
        WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ArticleLayoutGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationPaneColumn" Width="240" MinWidth="34" />
                <ColumnDefinition x:Name="NavigationPaneSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="ArticleListColumn" Width="2*" MinWidth="330" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="ArticlePlayerColumn" Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavigationPane" Grid.Column="0"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <DockPanel x:Name="NavigationPaneContent" Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                            <TextBlock Text="Navigate" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="CollapseNavigationPaneButton" DockPanel.Dock="Right"
                                    Padding="4,2" Margin="4,0,0,0" Click="CollapseNavigationPaneButton_Click"
                                    ToolTip="Collapse navigation pane"
                                    AutomationProperties.Name="Collapse navigation pane">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M 14,3 L 6,12 L 14,21 L 16,19 L 10,12 L 16,5 Z" />
                            </Button>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button x:Name="AllFeedsNavigationButton" Content="All feeds"
                                    HorizontalContentAlignment="Left" Padding="8,5"
                                    Click="AllFeedsNavigationButton_Click" />
                            <Button x:Name="StarredNavigationButton" Content="Starred"
                                    HorizontalContentAlignment="Left" Padding="8,5"
                                    Click="StarredNavigationButton_Click" />
                            <Button x:Name="FavoritesNavigationButton" Content="Favorites"
                                    HorizontalContentAlignment="Left" Padding="8,5"
                                    Click="FavoritesNavigationButton_Click" />
                            <Button x:Name="SearchNavigationButton" Content="Search"
                                    HorizontalContentAlignment="Left" Padding="8,5"
                                    Click="SearchNavigationButton_Click" />
                            <Button x:Name="HistoryNavigationButton" Content="Recent View History"
                                    HorizontalContentAlignment="Left" Padding="8,5"
                                    Click="HistoryNavigationButton_Click" />
                        </StackPanel>
                        <StackPanel x:Name="SearchOptionsPanel" DockPanel.Dock="Top" Visibility="Collapsed">
                            <TextBox x:Name="NavigationSearchTextBox" Margin="2,0,2,5"
                                     Padding="5,4" ToolTip="Search titles, categories, and article text"
                                     TextChanged="NavigationSearchTextBox_TextChanged" />
                            <ComboBox x:Name="NavigationSortComboBox" Margin="2,0,2,5"
                                      SelectionChanged="NavigationOptions_SelectionChanged"
                                      ToolTip="Sort search and history results">
                                <ComboBoxItem Content="Recent activity" Tag="recent" />
                                <ComboBoxItem Content="Title (A-Z)" Tag="title_ascending" />
                                <ComboBoxItem Content="Title (Z-A)" Tag="title_descending" />
                                <ComboBoxItem Content="Age (newest first)" Tag="age_newest" />
                                <ComboBoxItem Content="Age (oldest first)" Tag="age_oldest" />
                            </ComboBox>
                            <ComboBox x:Name="NavigationAgeComboBox" Margin="2,0,2,5"
                                      SelectionChanged="NavigationOptions_SelectionChanged"
                                      ToolTip="Limit results by age of the last view or listen">
                                <ComboBoxItem Content="Any age" Tag="any" />
                                <ComboBoxItem Content="Past day" Tag="day" />
                                <ComboBoxItem Content="Past week" Tag="week" />
                                <ComboBoxItem Content="Past month" Tag="month" />
                                <ComboBoxItem Content="Past year" Tag="year" />
                            </ComboBox>
                            <ComboBox x:Name="NavigationConsumptionComboBox" Margin="2,0,2,6"
                                      SelectionChanged="NavigationOptions_SelectionChanged"
                                      ToolTip="Filter by view or listening history">
                                <ComboBoxItem Content="Viewed or listened" Tag="any" />
                                <ComboBoxItem Content="Viewed (eye)" Tag="viewed" />
                                <ComboBoxItem Content="Listened (ear)" Tag="listened" />
                            </ComboBox>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Height="1" Margin="2,0,2,6"
                                Background="{DynamicResource BorderBrush}" />
                        <TextBlock DockPanel.Dock="Top" Text="Ctrl-click feeds/categories to combine filters"
                                   Margin="4,0,4,5" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="2,6,2,0">
                            <TextBlock x:Name="ExportProgressText" Margin="2,0,2,5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <ProgressBar x:Name="ExportProgressBar" Height="10" Margin="2,0,2,6"
                                         Minimum="0" Maximum="100" Value="0"
                                         Visibility="Collapsed" />
                            <Button x:Name="ExportLibraryButton" Content="Export commute MP3"
                                    HorizontalContentAlignment="Center" Padding="8,7"
                                    Click="ExportLibraryButton_Click"
                                    ToolTip="Export the currently visible Feeds Library articles as one MP3">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Top">
                                        <MenuItem Header="Titles only"
                                                  Click="ExportTitlesOnlyMenuItem_Click" />
                                        <MenuItem Header="Titles + bodies"
                                                  Click="ExportTitlesAndBodiesMenuItem_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NavigationTreeItems" />
                        </ScrollViewer>
                    </DockPanel>
                    <Button x:Name="ExpandNavigationPaneButton" Width="30"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Padding="4" Click="ExpandNavigationPaneButton_Click"
                            ToolTip="Expand navigation pane"
                            AutomationProperties.Name="Expand navigation pane"
                            Visibility="Collapsed">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Data="M 10,3 L 18,12 L 10,21 L 8,19 L 14,12 L 8,5 Z" />
                    </Button>
                </Grid>
            </Border>
            <GridSplitter x:Name="NavigationPaneSplitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" ShowsPreview="False"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE" ToolTip="Drag to resize the navigation pane"
                          DragCompleted="NavigationPaneSplitter_DragCompleted" />

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Feed Library" FontSize="18" FontWeight="SemiBold"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LibraryCountsText" Margin="8,0,0,0" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Click="SettingsButton_Click" Padding="6" Margin="12,0,0,0"
                            ToolTip="Settings" AutomationProperties.Name="Settings">
                        <Path Width="20" Height="20" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="GenerateButton" Click="GenerateButton_Click"
                                Padding="6" Margin="0,0,4,0" ToolTip="Update Feeds"
                                AutomationProperties.Name="Update Feeds">
                            <Grid Width="20" Height="20">
                                <Path x:Name="GenerateGlyph" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 17,10 A 7,7 0 0 0 4.8,5.3 M 4.8,5.3 L 3,3 M 4.8,5.3 L 7.5,5.3 M 3,10 A 7,7 0 0 0 15.2,14.7 M 15.2,14.7 L 17,17 M 15.2,14.7 L 12.5,14.7" />
                                <Path x:Name="GeneratePauseGlyph" Width="6" Height="8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M 0,0 H 2 V 8 H 0 Z M 4,0 H 6 V 8 H 4 Z"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="ScanModeButton" Padding="6" Margin="0,0,4,0"
                                ToolTip="Toggle Scan mode and Full mode"
                                AutomationProperties.Name="Toggle Scan mode and Full mode"
                                Click="ScanModeButton_Click">
                            <Path x:Name="ScanModeGlyph" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 12,2 A 10,10 0 0 1 22,12 A 10,10 0 0 1 12,22 A 10,10 0 0 1 2,12 A 10,10 0 0 1 12,2 M 12,12 L 6,5 M 12,2 V 4 M 22,12 H 20 M 12,22 V 20 M 2,12 H 4 M 12,8 A 4,4 0 0 1 16,12" />
                        </Button>
                        <Button Content="Mark visible as read" Padding="8,4" Margin="0,0,4,0"
                                ToolTip="Mark all articles currently visible in the Feed Library as read"
                                Click="MarkAllReadButton_Click" />
                        <Button x:Name="SortMenuButton" Click="SortMenuButton_Click"
                                Padding="6" Margin="0,0,4,0" ToolTip="Sort"
                                AutomationProperties.Name="Sort">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Data="M 3,5 H 13 V 7 H 3 Z M 3,11 H 11 V 13 H 3 Z M 3,17 H 9 V 19 H 3 Z M 17,19 V 8 L 14,11 12.6,9.6 18,4.2 23.4,9.6 22,11 19,8 V 19 Z" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Sort by">
                                        <MenuItem x:Name="SortAlphabeticalAscendingMenuItem"
                                                  Header="Alphabetically (A–Z) ↑" Tag="alphabetical_ascending"
                                                  IsCheckable="True" Click="ArticleSortMenuItem_Click" />
                                        <MenuItem x:Name="SortAlphabeticalDescendingMenuItem"
                                                  Header="Alphabetically (Z–A) ↓" Tag="alphabetical_descending"
                                                  IsCheckable="True" Click="ArticleSortMenuItem_Click" />
                                        <Separator />
                                        <MenuItem x:Name="SortNewestFirstMenuItem" Header="Newest First ↓"
                                                  Tag="newest_first" IsCheckable="True"
                                                  Click="ArticleSortMenuItem_Click" />
                                        <MenuItem x:Name="SortOldestFirstMenuItem" Header="Oldest First ↑"
                                                  Tag="oldest_first" IsCheckable="True"
                                                  Click="ArticleSortMenuItem_Click" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem x:Name="GroupByFeedMenuItem" Header="Group by Feed"
                                              IsCheckable="True" Click="GroupByFeedMenuItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="FilterMenuButton" Click="FilterMenuButton_Click"
                                Padding="6" ToolTip="Filter" AutomationProperties.Name="Filter">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Data="M 2,4 H 22 V 6 H 2 Z M 5,9 H 19 V 11 H 5 Z M 8,14 H 16 V 16 H 8 Z M 10,19 H 14 V 21 H 10 Z" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="UnplayedOnlyMenuItem" Header="Unread only"
                                              IsCheckable="True" Click="UnplayedOnlyMenuItem_Click" />
                                    <MenuItem x:Name="StarredOnlyMenuItem" Header="Starred only"
                                              IsCheckable="True" Click="StarredOnlyMenuItem_Click" />
                                    <MenuItem x:Name="FavoriteCategoriesOnlyMenuItem" Header="Favorites"
                                              IsCheckable="True" Click="FavoriteCategoriesOnlyMenuItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="AudioMuteButton" Click="AudioMuteButton_Click"
                                Padding="6" Margin="4,0,0,0"
                                ToolTip="Mute audio" AutomationProperties.Name="Mute audio">
                            <Path x:Name="AudioMuteGlyph" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 3,9 H 7 L 12,5 V 19 L 7,15 H 3 Z M 16,9 A 4,4 0 0 1 16,15 M 18,6 A 8,8 0 0 1 18,18" />
                        </Button>
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="ArticleList" SelectionChanged="ArticleList_SelectionChanged"
                         SelectionMode="Extended"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlayed}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ReadArticleBackgroundBrush}" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,10,8,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7" Background="Transparent"
                                    PreviewMouseRightButtonDown="ArticleItem_PreviewMouseRightButtonDown"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72" Height="72" Margin="0,0,10,0" VerticalAlignment="Top"
                                            Background="{DynamicResource BorderBrush}" CornerRadius="3" ClipToBounds="True">
                                        <Image Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Source>
                                                <Binding Path="ThumbnailUri">
                                                    <Binding.Converter>
                                                        <services:ThumbnailSourceConverter />
                                                    </Binding.Converter>
                                                </Binding>
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <Grid Grid.Column="1" MinHeight="72">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button x:Name="ArticleTitleButton" Tag="{Binding}"
                                                HorizontalContentAlignment="Left" VerticalAlignment="Top"
                                                Padding="0" BorderThickness="0"
                                                PreviewMouseLeftButtonDown="ArticleTitleButton_PreviewMouseLeftButtonDown"
                                                Click="ArticleTitleButton_Click">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       MaxHeight="60" />
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}">
                                                                    <ContentPresenter
                                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                        TextElement.Foreground="{TemplateBinding Foreground}" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayed}" Value="True">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Bottom">
                                                <Button Content="{Binding StarLabel}" Tag="{Binding}"
                                                        Padding="4,0" BorderThickness="0" Background="Transparent"
                                                        ToolTip="Toggle article star" FontSize="18" FontFamily="Segoe UI Symbol"
                                                        Click="StarArticleButton_Click" />
                                                <Button Content="✓" Tag="{Binding}" FontFamily="Segoe UI Symbol"
                                                        Padding="5,0" BorderThickness="0" Background="Transparent"
                                                        Foreground="White" FontSize="17"
                                                        Click="MarkButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="ToolTip" Value="Mark article as read" />
                                                            <Setter Property="AutomationProperties.Name" Value="Mark article as read" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlayed}" Value="True">
                                                                    <Setter Property="Foreground" Value="LimeGreen" />
                                                                    <Setter Property="ToolTip" Value="Mark article as unread" />
                                                                    <Setter Property="AutomationProperties.Name" Value="Mark article as unread" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Tag="{Binding}" Padding="4,0" BorderThickness="0"
                                                        Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                                        ToolTip="Delete article audio and saved details"
                                                        AutomationProperties.Name="Delete article audio and saved details"
                                                        Click="DeleteArticleButton_Click">
                                                    <Path Width="16" Height="16" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          Data="M 8,3 H 16 L 17,5 H 21 V 7 H 3 V 5 H 7 Z M 5,9 H 19 L 18,21 H 6 Z M 9,11 V 18 H 11 V 11 Z M 13,11 V 18 H 15 V 11 Z" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding FeedDisplayName}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding RelativeDateTime}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Path Width="14" Height="12" Margin="0,0,5,0"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.3" StrokeLineJoin="Round"
                                                          Data="M 1,6 C 3,2 6,1 8,1 C 11,1 14,3 16,6 C 14,9 11,11 8,11 C 5,11 3,9 1,6 Z M 8,4 A 2,2 0 1 0 8,8 A 2,2 0 1 0 8,4">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasBeenViewed}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <Path Width="14" Height="12" Margin="0,0,5,0"
                                                          Stroke="#2EA043" ToolTip="Unread - multiple images/videos"
                                                          StrokeThickness="1.6" StrokeLineJoin="Round"
                                                          Data="M 1,6 C 3,2 6,1 8,1 C 11,1 14,3 16,6 C 14,9 11,11 8,11 C 5,11 3,9 1,6 Z M 8,4 A 2,2 0 1 0 8,8 A 2,2 0 1 0 8,4">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasMultipleMedia}" Value="True" />
                                                                            <Condition Binding="{Binding HasBeenViewed}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <Path Width="12" Height="14"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.3" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M 8,1 C 4,1 2,4 2,7 C 2,10 5,10 5,12 C 5,14 9,14 10,11 C 11,8 8,8 8,6 C 8,5 10,5 10,7">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasBeenListenedTo}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                    <Grid Grid.Column="0" Width="36" Height="36"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavoriteCategory}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Polygon Points="0,0 36,0 0,36"
                                                 Stroke="#FF9B5D12" StrokeThickness="0.8">
                                            <Polygon.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFFFE58A" Offset="0" />
                                                    <GradientStop Color="#FFFFC83D" Offset="0.48" />
                                                    <GradientStop Color="#FFD88A16" Offset="1" />
                                                </LinearGradientBrush>
                                            </Polygon.Fill>
                                        </Polygon>
                                        <Path Data="M 12,3 L 14.6,9.1 L 21.2,9.7 L 16.2,14 L 17.7,20.4 L 12,17 L 6.3,20.4 L 7.8,14 L 2.8,9.7 L 9.4,9.1 Z"
                                              Fill="#FFFFF8D9" Stroke="#FF9B5D12"
                                              StrokeThickness="0.65" StrokeLineJoin="Round"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Margin="4,2,0,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" ShowsPreview="False" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE" ToolTip="Drag to resize the article list and player"
                          DragCompleted="ArticleGridSplitter_DragCompleted" />

            <Border Grid.Column="4" Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PlayerSourceThumbnail"
                                Width="{Binding ActualHeight, ElementName=NowPlayingTitle}"
                                Height="{Binding ActualHeight, ElementName=NowPlayingTitle}"
                                Margin="0,0,14,0" Background="{DynamicResource BorderBrush}"
                                CornerRadius="6" ClipToBounds="True" VerticalAlignment="Top"
                                Visibility="Collapsed">
                            <Image x:Name="PlayerSourceThumbnailImage"
                                   Stretch="Uniform" StretchDirection="Both"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   ImageFailed="PlayerSourceThumbnailImage_ImageFailed" />
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="NowPlayingTitle" Text="Select an article to listen"
                                       FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Top" />
                            <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,8,0,0">
                          <Button x:Name="RebuildArticleButton" DockPanel.Dock="Right" Padding="6,0"
                                  Margin="4,0,0,0" ToolTip="Rebuild article audio and media"
                                  AutomationProperties.Name="Rebuild article audio and media"
                                  Click="RebuildArticleButton_Click" IsEnabled="False">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 17,10 A 7,7 0 0 0 4.8,5.3 M 4.8,5.3 L 3,3 M 4.8,5.3 L 7.5,5.3 M 3,10 A 7,7 0 0 0 15.2,14.7 M 15.2,14.7 L 17,17 M 15.2,14.7 L 12.5,14.7" />
                          </Button>
                          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="StarCurrentButton" Content="☆" FontFamily="Segoe UI Symbol"
                                    Padding="5,0" Margin="0,0,4,0" FontSize="20"
                                    ToolTip="Toggle article star" AutomationProperties.Name="Toggle article star"
                                    Click="StarCurrentButton_Click" />
                            <Button x:Name="MarkCurrentReadButton" Content="✓" FontFamily="Segoe UI Symbol" Padding="5,0"
                                    FontSize="20" Foreground="White" ToolTip="Mark article as read"
                                    AutomationProperties.Name="Mark article as read"
                                    Click="MarkCurrentReadButton_Click" />
                            <ToggleButton x:Name="ShowArticleTextToggle" Margin="4,0,0,0" Padding="6,0"
                                          ToolTip="Show article text"
                                          AutomationProperties.Name="Show article text"
                                          Click="ShowArticleTextToggle_Click">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 3,4 H 17 M 3,9 H 17 M 3,14 H 14 M 3,19 H 11" />
                            </ToggleButton>
                            <Button x:Name="LoadInBrowserButton" Margin="4,0,0,0" Padding="6,0"
                                    ToolTip="Load in browser"
                                    AutomationProperties.Name="Load in browser"
                                    Click="LoadInBrowserButton_Click"
                                    PreviewMouseRightButtonDown="LoadInBrowserButton_PreviewMouseRightButtonDown">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 10,4 H 4 V 18 H 18 V 12 M 13,3 H 19 V 9 M 19,3 L 10,12" />
                            </Button>
                            <Button x:Name="AiChatButton" Content="AI" Margin="4,0,0,0" Padding="6,0"
                                    ToolTip="Choose an AI chat agent"
                                    AutomationProperties.Name="Choose an AI chat agent"
                                    Click="AiChatButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="Grok" Tag="grok" Click="AiChatMenuItem_Click" />
                                        <MenuItem Header="ChatGPT" Tag="chatgpt" Click="AiChatMenuItem_Click" />
                                        <MenuItem Header="Claude" Tag="claude" Click="AiChatMenuItem_Click" />
                                        <MenuItem Header="Microsoft Copilot" Tag="copilot" Click="AiChatMenuItem_Click" />
                                        <MenuItem Header="Perplexity" Tag="perplexity" Click="AiChatMenuItem_Click" />
                                        <MenuItem Header="Google Gemini (clipboard only)" Tag="gemini" Click="AiChatMenuItem_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock x:Name="CurrentArticleDateTime" Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ArticleMediaLayout" Grid.Row="1" Margin="0,14,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ArticleImageRow" Height="2*" />
                            <RowDefinition x:Name="ArticleImageTextSplitterRow" Height="6" />
                            <RowDefinition x:Name="ArticleTextRow" Height="1*" />
                        </Grid.RowDefinitions>
                        <MediaElement x:Name="StartupSplashVideo" Grid.RowSpan="3"
                                      Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                      MediaOpened="StartupSplashVideo_MediaOpened"
                                      MediaEnded="StartupSplashVideo_MediaEnded"
                                      MediaFailed="StartupSplashVideo_MediaFailed"
                                      Visibility="Collapsed" />
                        <Image x:Name="StartupLogoImage" Grid.RowSpan="3"
                               Source="pack://application:,,,/Assets/AnchorFeedsLogo.png" Stretch="Uniform"
                               MaxWidth="420" MaxHeight="420" Margin="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                        <Border x:Name="ArticleImagePanel" Grid.Row="0" Background="{DynamicResource ImageBackgroundBrush}"
                                CornerRadius="6" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image x:Name="ArticleImage" Stretch="Uniform"
                                       MouseLeftButtonUp="ArticleImage_MouseLeftButtonUp" />
                                <Button x:Name="OpenVideoButton" Grid.Row="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,12,12" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="Open video in browser"
                                        AutomationProperties.Name="Open video in browser"
                                        Visibility="Collapsed"
                                        Click="OpenVideoButton_Click" />
                                <StackPanel x:Name="MediaNavigationPanel" Grid.Row="1" Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,4,0,4" Visibility="Collapsed">
                                    <Button x:Name="MediaPreviousButton" Content="‹" Width="30" FontSize="18"
                                            Padding="0,-3,0,0" ToolTip="Previous image or video"
                                            Click="MediaPreviousButton_Click" />
                                    <TextBlock x:Name="MediaPositionText" VerticalAlignment="Center"
                                               Margin="12,0" MinWidth="70" TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button x:Name="MediaNextButton" Content="›" Width="30" FontSize="18"
                                            Padding="0,-3,0,0" ToolTip="Next image or video"
                                            Click="MediaNextButton_Click" />
                                </StackPanel>
                                <Border x:Name="ScanCountdownOverlay" Background="#B8000000"
                                        CornerRadius="6" Visibility="Collapsed" Cursor="Hand"
                                        MouseLeftButtonUp="ScanCountdownOverlay_MouseLeftButtonUp">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Next article in" Foreground="White"
                                                   HorizontalAlignment="Center" FontSize="20"
                                                   Margin="0,0,0,8" />
                                        <TextBlock x:Name="ScanCountdownText" Text="7"
                                                   Foreground="White" FontSize="64" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <Border Width="72" Height="72" CornerRadius="36"
                                                Background="White" IsHitTestVisible="False">
                                            <Path Width="24" Height="24" Stretch="Uniform"
                                                  Fill="#252525"
                                                  Data="M 2,0 L 22,12 L 2,24 Z" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <GridSplitter x:Name="ArticleImageTextSplitter" Grid.Row="1" Height="6"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}" ShowsPreview="False"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      Cursor="SizeNS" ToolTip="Drag to resize the article image and text"
                                      Visibility="Collapsed"
                                      DragCompleted="ArticleImageTextSplitter_DragCompleted" />
                        <Border x:Name="ArticleTextPanel" Grid.Row="2" Background="{DynamicResource ArticleTextBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <FlowDocumentScrollViewer x:Name="ArticleTextContent"
                                                      VerticalScrollBarVisibility="Auto"
                                                      IsSelectionEnabled="True"
                                                      IsToolBarVisible="False"
                                                      Background="Transparent"
                                                      ContextMenuOpening="ArticleTextContent_ContextMenuOpening">
                                <FlowDocumentScrollViewer.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="ArticleTextSearchMenuItem" Header="Search">
                                            <MenuItem Header="Google" Tag="google"
                                                      Click="ArticleTextSearchMenuItem_Click" />
                                            <MenuItem Header="Bing" Tag="bing"
                                                      Click="ArticleTextSearchMenuItem_Click" />
                                            <MenuItem Header="DuckDuckGo" Tag="duckduckgo"
                                                      Click="ArticleTextSearchMenuItem_Click" />
                                            <MenuItem Header="Brave" Tag="brave"
                                                      Click="ArticleTextSearchMenuItem_Click" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem x:Name="ArticleTextCopyMenuItem" Header="Copy to clipboard"
                                                  Click="ArticleTextCopyMenuItem_Click" />
                                    </ContextMenu>
                                </FlowDocumentScrollViewer.ContextMenu>
                            </FlowDocumentScrollViewer>
                        </Border>
                    </Grid>
                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Padding="7" Margin="0,0,4,0" Click="PreviousButton_Click"
                                    ToolTip="Previous" AutomationProperties.Name="Previous">
                                <Path Width="16" Height="16"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M 15,1 L 6,8 L 15,15 Z M 5,1 H 1 V 15 H 5 Z" />
                            </Button>
                            <Button x:Name="PlayPauseButton" Padding="7" Margin="0,0,4,0" Click="PlayPauseButton_Click"
                                    ToolTip="Play" AutomationProperties.Name="Play">
                                <Path x:Name="PlayPauseIcon" Width="16" Height="16"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M 3,1 L 15,8 L 3,15 Z" />
                            </Button>
                            <Button Padding="7" Margin="0,0,10,0" Click="NextButton_Click"
                                    ToolTip="Next / Skip" AutomationProperties.Name="Next / Skip">
                                <Path Width="16" Height="16"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M 1,1 L 10,8 L 1,15 Z M 11,1 H 15 V 15 H 11 Z" />
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="ShareButtonsPanel" DockPanel.Dock="Right"
                                    Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Tag="x" Padding="5,2" Margin="2,0"
                                    Click="ShareArticleButton_Click" ToolTip="Share on X"
                                    AutomationProperties.Name="Share on X">
                                <TextBlock Text="𝕏" FontFamily="Segoe UI Symbol" FontWeight="SemiBold" />
                            </Button>
                            <Button Tag="facebook" Padding="7,2" Margin="2,0"
                                    Click="ShareArticleButton_Click" ToolTip="Share on Facebook"
                                    AutomationProperties.Name="Share on Facebook">
                                <TextBlock Text="f" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16" />
                            </Button>
                            <Button Tag="email" Padding="5,2" Margin="2,0"
                                    Click="ShareArticleButton_Click" ToolTip="Share by email"
                                    AutomationProperties.Name="Share by email">
                                <Path Width="18" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round"
                                      Data="M 1,2 H 17 V 14 H 1 Z M 1,3 L 9,9 L 17,3" />
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <Slider x:Name="PositionSlider" Minimum="0" Maximum="1"
                                    ValueChanged="PositionSlider_ValueChanged"
                                    PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PositionText" Text="0:00.00" />
                                <TextBlock x:Name="DurationText" Grid.Column="1" Margin="12,0,0,0"
                                           Text="0:00.00" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                    <MediaElement x:Name="AudioPlayer" Grid.Row="2" Height="1" Opacity="0"
                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  MediaOpened="AudioPlayer_MediaOpened" MediaEnded="AudioPlayer_MediaEnded"
                                  MediaFailed="AudioPlayer_MediaFailed" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,4,0,0">
            <ProgressBar x:Name="GenerationProgress" DockPanel.Dock="Right" Width="170" Height="12"
                         IsIndeterminate="True" Visibility="Collapsed" Margin="4,0,0,0" />
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
