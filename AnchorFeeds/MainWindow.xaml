<Window x:Class="AnchorFeeds.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnchorFeeds" Height="760" Width="1120" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="-16,-16,-16,8">
            <MenuItem Header="File">
                <MenuItem Header="Exit" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem x:Name="ShowArticleTextMenuItem" Header="Show article text" IsCheckable="True"
                          Click="ShowArticleTextMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="Settings">
                <MenuItem Header="Configure all settings..." Click="ConfigureSettingsMenuItem_Click" />
                <MenuItem Header="Rebuild Library..." Click="RebuildLibraryMenuItem_Click" />
                <Separator />
                <MenuItem Header="Playback">
                    <MenuItem x:Name="AutoPlayNextMenuItem" Header="Auto Play Next" IsCheckable="True"
                              Click="AutoPlayNextMenuItem_Click" />
                    <MenuItem Header="Mark as played">
                        <MenuItem x:Name="WhenStartedMenuItem" Header="When started" Tag="when_started"
                                  IsCheckable="True" Click="PlayedRuleMenuItem_Click" />
                        <MenuItem x:Name="WhenEndedMenuItem" Header="When ended or skipped"
                                  Tag="when_ended_or_skipped" IsCheckable="True"
                                  Click="PlayedRuleMenuItem_Click" />
                    </MenuItem>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid x:Name="ArticleLayoutGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArticleListColumn" Width="2*" MinWidth="330" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="ArticlePlayerColumn" Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock Text="Feed Library" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="GenerateButton" Click="GenerateButton_Click"
                                Padding="6" Margin="0,0,4,0" ToolTip="Update Feeds"
                                AutomationProperties.Name="Update Feeds">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                                  Data="M 17.65,6.35 A 8,8 0 0,0 4.35,5.35 L 2.5,3.5 V 9 H 8 L 5.76,6.76 A 6,6 0 1,1 4,12 H 2 A 8,8 0 1,0 17.65,6.35 Z M 18,3 V 8 H 13 L 14.85,6.15 A 8,8 0 0,0 18,3 Z" />
                        </Button>
                        <Button Content="Mark all read" Padding="8,4" Margin="0,0,4,0"
                                Click="MarkAllReadButton_Click" />
                        <Button x:Name="SortMenuButton" Click="SortMenuButton_Click"
                                Padding="6" Margin="0,0,4,0" ToolTip="Sort"
                                AutomationProperties.Name="Sort">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                                  Data="M 3,5 H 13 V 7 H 3 Z M 3,11 H 11 V 13 H 3 Z M 3,17 H 9 V 19 H 3 Z M 17,19 V 8 L 14,11 12.6,9.6 18,4.2 23.4,9.6 22,11 19,8 V 19 Z" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Sort by">
                                        <MenuItem x:Name="SortAlphabeticalAscendingMenuItem"
                                                  Header="Alphabetically (A–Z) ↑" Tag="alphabetical_ascending"
                                                  IsCheckable="True" Click="ArticleSortMenuItem_Click" />
                                        <MenuItem x:Name="SortAlphabeticalDescendingMenuItem"
                                                  Header="Alphabetically (Z–A) ↓" Tag="alphabetical_descending"
                                                  IsCheckable="True" Click="ArticleSortMenuItem_Click" />
                                        <Separator />
                                        <MenuItem x:Name="SortNewestFirstMenuItem" Header="Newest First ↓"
                                                  Tag="newest_first" IsCheckable="True"
                                                  Click="ArticleSortMenuItem_Click" />
                                        <MenuItem x:Name="SortOldestFirstMenuItem" Header="Oldest First ↑"
                                                  Tag="oldest_first" IsCheckable="True"
                                                  Click="ArticleSortMenuItem_Click" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem x:Name="GroupByFeedMenuItem" Header="Group by Feed"
                                              IsCheckable="True" Click="GroupByFeedMenuItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="FilterMenuButton" Click="FilterMenuButton_Click"
                                Padding="6" ToolTip="Filter" AutomationProperties.Name="Filter">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                                  Data="M 2,4 H 22 V 6 H 2 Z M 5,9 H 19 V 11 H 5 Z M 8,14 H 16 V 16 H 8 Z M 10,19 H 14 V 21 H 10 Z" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="UnplayedOnlyMenuItem" Header="Unread only"
                                              IsCheckable="True" Click="UnplayedOnlyMenuItem_Click" />
                                    <MenuItem x:Name="StarredOnlyMenuItem" Header="Starred only"
                                              IsCheckable="True" Click="StarredOnlyMenuItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="ArticleList" SelectionChanged="ArticleList_SelectionChanged"
                         Background="{DynamicResource SurfaceBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,10,8,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <DockPanel>
                                        <Button Content="🗑" Tag="{Binding}" DockPanel.Dock="Right"
                                                Padding="4,0" BorderThickness="0" Background="Transparent"
                                                ToolTip="Delete article audio and saved details" FontSize="16"
                                                Click="DeleteArticleButton_Click" />
                                        <Button Content="✓" Tag="{Binding}" DockPanel.Dock="Right"
                                                Padding="5,0" BorderThickness="0" Background="Transparent"
                                                Foreground="{DynamicResource AccentBrush}" FontSize="17"
                                                ToolTip="Mark article as read"
                                                AutomationProperties.Name="Mark article as read"
                                                Click="MarkButton_Click" />
                                        <Button Content="{Binding StarLabel}" Tag="{Binding}" DockPanel.Dock="Right"
                                                Padding="4,0" BorderThickness="0" Background="Transparent"
                                                ToolTip="Toggle article star" FontSize="18"
                                                Click="StarArticleButton_Click" />
                                        <Button Content="{Binding Title}" Tag="{Binding}" HorizontalContentAlignment="Left"
                                                Padding="0" BorderThickness="0" Background="Transparent"
                                                Click="ArticleTitleButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayed}" Value="True">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Feed}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding DisplayDateTime}" DockPanel.Dock="Right"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" ShowsPreview="False" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE" ToolTip="Drag to resize the article list and player"
                          DragCompleted="ArticleGridSplitter_DragCompleted" />

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="NowPlayingTitle" Text="Select an article to listen"
                                   FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Button x:Name="StarCurrentButton" Content="☆" HorizontalAlignment="Left"
                                Padding="5,0" Margin="0,8,0,0" FontSize="20"
                                ToolTip="Toggle article star" AutomationProperties.Name="Toggle article star"
                                Click="StarCurrentButton_Click" />
                    </StackPanel>
                    <Grid x:Name="ArticleMediaLayout" Grid.Row="1" Margin="0,14,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ArticleImageRow" Height="3*" />
                            <RowDefinition x:Name="ArticleTextRow" Height="2*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="ArticleImagePanel" Grid.Row="0" Background="{DynamicResource ImageBackgroundBrush}"
                                CornerRadius="6" Visibility="Collapsed">
                            <Grid>
                                <Image x:Name="ArticleImage" Stretch="UniformToFill"
                                       MouseLeftButtonUp="ArticleImage_MouseLeftButtonUp" />
                                <Border x:Name="ScanCountdownOverlay" Background="#B8000000"
                                        CornerRadius="6" Visibility="Collapsed" Cursor="Hand"
                                        MouseLeftButtonUp="ScanCountdownOverlay_MouseLeftButtonUp">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Next article in" Foreground="White"
                                                   HorizontalAlignment="Center" FontSize="20" />
                                        <TextBlock x:Name="ScanCountdownText" Text="7"
                                                   Foreground="White" FontSize="64" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="ArticleTextPanel" Grid.Row="1" Background="{DynamicResource ArticleTextBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Article text" FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <ScrollViewer x:Name="ArticleTextScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ArticleTextContent" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ArticleTextForegroundBrush}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ScanModeButton" Padding="5,0" Margin="0,0,4,0"
                                    ToolTip="Toggle Scan mode and Full mode"
                                    AutomationProperties.Name="Toggle Scan mode and Full mode"
                                    Click="ScanModeButton_Click">
                                <Path x:Name="ScanModeGlyph" Width="19" Height="19"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button x:Name="MarkCurrentReadButton" Content="✓" Padding="5,0"
                                    Margin="0,0,4,0" FontSize="17" ToolTip="Mark article as read"
                                    AutomationProperties.Name="Mark article as read"
                                    Click="MarkCurrentReadButton_Click" />
                            <Button x:Name="PlaybackSpeedButton" Padding="5,0" Margin="0,0,8,0"
                                    ToolTip="Playback speed"
                                    AutomationProperties.Name="Playback speed"
                                    Click="PlaybackSpeedButton_Click">
                                <Canvas Width="32" Height="24">
                                    <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 1,6 H 8 M 0,11 H 7 M 2,16 H 8" />
                                    <Ellipse Canvas.Left="10" Canvas.Top="2" Width="20" Height="20"
                                             Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2.5" />
                                    <Ellipse Canvas.Left="17" Canvas.Top="9" Width="6" Height="6"
                                             Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" />
                                    <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 13,6 L 16,8 M 24,5 L 26,8 M 28,13 L 25,14 M 24,21 L 22,18 M 14,20 L 16,17" />
                                </Canvas>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="PlaybackSpeedContextMenu">
                                        <MenuItem x:Name="Speed07MenuItem" Header="0.7x" Tag="0.7" IsCheckable="True"
                                                  Click="PlaybackSpeedMenuItem_Click" />
                                        <MenuItem x:Name="Speed08MenuItem" Header="0.8x" Tag="0.8" IsCheckable="True"
                                                  Click="PlaybackSpeedMenuItem_Click" />
                                        <MenuItem x:Name="Speed09MenuItem" Header="0.9x" Tag="0.9" IsCheckable="True"
                                                  Click="PlaybackSpeedMenuItem_Click" />
                                        <MenuItem x:Name="Speed1MenuItem" Header="1x" Tag="1" IsCheckable="True"
                                                  Click="PlaybackSpeedMenuItem_Click" />
                                        <MenuItem x:Name="Speed11MenuItem" Header="1.1x" Tag="1.1" IsCheckable="True"
                                                  Click="PlaybackSpeedMenuItem_Click" />
                                        <MenuItem x:Name="Speed12MenuItem" Header="1.2x" Tag="1.2" IsCheckable="True"
                                                  Click="PlaybackSpeedMenuItem_Click" />
                                        <MenuItem x:Name="Speed13MenuItem" Header="1.3x" Tag="1.3" IsCheckable="True"
                                                  Click="PlaybackSpeedMenuItem_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Padding="7" Margin="0,0,4,0" Click="PlayButton_Click"
                                    ToolTip="Play" AutomationProperties.Name="Play">
                                <Path Width="16" Height="16" Fill="{DynamicResource TextPrimaryBrush}"
                                      Data="M 3,1 L 15,8 L 3,15 Z" />
                            </Button>
                            <Button Padding="7" Margin="0,0,4,0" Click="PauseButton_Click"
                                    ToolTip="Pause" AutomationProperties.Name="Pause">
                                <Path Width="16" Height="16" Fill="{DynamicResource TextPrimaryBrush}"
                                      Data="M 2,1 H 6 V 15 H 2 Z M 10,1 H 14 V 15 H 10 Z" />
                            </Button>
                            <Button Padding="7" Margin="0,0,10,0" Click="NextButton_Click"
                                    ToolTip="Next / Skip" AutomationProperties.Name="Next / Skip">
                                <Path Width="16" Height="16" Fill="{DynamicResource TextPrimaryBrush}"
                                      Data="M 1,1 L 10,8 L 1,15 Z M 11,1 H 15 V 15 H 11 Z" />
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <Slider x:Name="PositionSlider" Minimum="0" Maximum="1"
                                    ValueChanged="PositionSlider_ValueChanged"
                                    PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PositionText" Text="0:00.00" />
                                <TextBlock x:Name="DurationText" Grid.Column="1" Margin="12,0,0,0"
                                           Text="0:00.00" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                    <MediaElement x:Name="AudioPlayer" Grid.Row="2" Height="1" Opacity="0"
                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  MediaOpened="AudioPlayer_MediaOpened" MediaEnded="AudioPlayer_MediaEnded"
                                  MediaFailed="AudioPlayer_MediaFailed" />
                    <MediaElement x:Name="TitleAudioPlayer" Grid.Row="2" Height="1" Opacity="0"
                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  MediaOpened="TitleAudioPlayer_MediaOpened"
                                  MediaEnded="TitleAudioPlayer_MediaEnded"
                                  MediaFailed="TitleAudioPlayer_MediaFailed" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <ProgressBar x:Name="GenerationProgress" DockPanel.Dock="Right" Width="170" Height="14"
                         IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,0,0" />
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
